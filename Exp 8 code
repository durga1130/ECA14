#define GreenLed 12
#define Sensor A0

void setup()
{
  pinMode(GreenLed, OUTPUT);
  Serial.begin(9600);
}

void loop()
{
  int value = analogRead(Sensor);

  Serial.print("Analogic Value coming from the sensor : ");
  Serial.println(value);

  if (value > 600)
  {
    digitalWrite(GreenLed, HIGH);
  }
  else
  {
    digitalWrite(GreenLed, LOW);
  }

  delay(500);
}
